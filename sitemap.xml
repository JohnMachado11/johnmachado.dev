---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://johnmachado.dev/</loc>
    <lastmod>2026-10-25</lastmod>
  </url>
  {%- if site.posts.size > 0 %}
  <url>
    <loc>https://johnmachado.dev/blog/</loc>
    <lastmod>{{ site.posts.first.date | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {%- for post in site.posts %}
  <url>
    <loc>https://johnmachado.dev{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {%- endfor %}
  {%- endif %}
</urlset>
